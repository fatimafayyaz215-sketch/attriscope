# Copy to .env.local and fill in your values:
#   copy .env.example .env.local

# Required — Supabase
# URL: Settings → General → Project URL (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Key: Settings → API Keys → Publishable key → copy (sb_publishable_...)
# Env var name stays ANON_KEY for compatibility — use Publishable, NOT Secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Optional — Google Gemini (single key)
GEMINI_API_KEY=

# Optional — comma-separated keys for rate-limit rotation (overrides GEMINI_API_KEY when set)
# GEMINI_API_KEYS=key_one,key_two,key_three
